<script>
const SHARE_WARN=<?=SHARE_WARN?>;
let selFile='',selSize=0;
const basePath=<?=json_encode($relPath?$relPath.'/':'')?>;
const scriptPath=<?=json_encode($_SERVER['SCRIPT_NAME']??'/lsfilter.php')?>;
const dirBase=scriptPath.replace(/\/[^/]+$/,'/');
const curMode=<?=json_encode($mode)?>;

let _touchStartY=0, _touchStartX=0, _longPressTimer=null, _longPressTarget=null;
const LONG_PRESS_MS=500, SCROLL_THRESHOLD=8;

function _isMoved(e){
    const t=e.changedTouches[0];
    return Math.abs(t.clientY-_touchStartY)>SCROLL_THRESHOLD
        || Math.abs(t.clientX-_touchStartX)>SCROLL_THRESHOLD;
}

document.addEventListener('touchstart', e=>{
    const t=e.touches[0];
    _touchStartY=t.clientY; _touchStartX=t.clientX;
    const el=e.target.closest('[data-sort],[data-name],[data-regex],[data-mode-set],[data-close]');
    if(!el) return;
    if(el.dataset.sort){
        _longPressTarget=el;
        _longPressTimer=setTimeout(()=>{
            if(_longPressTarget){
                el.classList.add('long-press-active');
                navigator.vibrate&&navigator.vibrate(40);
                doSort(el.dataset.sort, true);
                _longPressTarget=null;
            }
        }, LONG_PRESS_MS);
    }
}, {passive:true});

document.addEventListener('touchend', e=>{
    clearTimeout(_longPressTimer);
    const el=e.target.closest('[data-sort],[data-name],[data-regex],[data-mode-set],[data-close]');
    if(!el) return;
    if(_isMoved(e)) { _longPressTarget=null; return; }
    if(_longPressTarget===null&&el.dataset.sort) return;
    e.preventDefault();
    _longPressTarget=null;
    el.classList.remove('long-press-active');
    _dispatch(el);
}, {passive:false});

document.addEventListener('click', e=>{
    const el=e.target.closest('[data-sort],[data-name],[data-regex],[data-mode-set],[data-close]');
    if(!el) return;
    if(el.dataset.sort) doSort(el.dataset.sort, false);
    else _dispatch(el);
});

function _dispatch(el){
    if(el.dataset.close!==undefined){ closeAll(); return; }
    if(el.dataset.sortReset!==undefined){
        const f=document.getElementById('ff');
        f.querySelector('[name=sort]').value='name';
        f.querySelector('[name=dir]').value='asc';
        f.querySelector('[name=sort2]').value='';
        f.querySelector('[name=dir2]').value='asc';
        f.submit(); return;
    }
    if(el.id==='hintToggle'){
        const hb=document.getElementById('hintBox');
        hb.classList.toggle('open'); return;
    }
    if(el.dataset.modeSet){ setMode(el.dataset.modeSet); return; }
    if(el.dataset.regex!==undefined){ applyTpl(el.dataset.regex, el.dataset.mode||'regex'); return; }
    if(el.dataset.name!==undefined){ openMenu(el.dataset.name, el.dataset.isdir==='1', parseInt(el.dataset.size||0)); return; }
    if(el.dataset.sort){ doSort(el.dataset.sort, false); return; }
}

function showM(id){document.getElementById(id).style.display='block';document.getElementById('overlay').style.display='block';}
function closeAll(){document.querySelectorAll('.modal').forEach(m=>m.style.display='none');document.getElementById('overlay').style.display='none';}

function openMenu(name,isDir,size){
    if(isDir){window.location.href='?path='+encodeURIComponent(basePath+name)+'&mode='+encodeURIComponent(curMode);return;}
    selFile=name;selSize=size;
    document.getElementById('mTitle').innerText=name;
    let meta='';
    if(size>0){meta=size+' B ('+(size/1024).toFixed(1)+' KB)';if(size>=SHARE_WARN)meta+=' · ⚠ Groß';}
    document.getElementById('mMeta').innerText=meta;
    document.getElementById('btnShare').innerHTML=size>=SHARE_WARN
        ?'📤 2. Textinhalt teilen ⚠ '+(size/1024).toFixed(0)+'KB'
        :'📤 2. Textinhalt teilen';
    showM('actionMenu');
}

function applyTpl(regex,forceMode){
    document.getElementById('pIn').value=regex;
    if(forceMode) document.getElementById('modeIn').value=forceMode;
    document.getElementById('ff').submit();
}

function setMode(m){
    document.getElementById('modeIn').value=m;
    document.querySelectorAll('.mode-btn').forEach(b=>b.classList.toggle('active',b.dataset.modeSet===m));
    document.getElementById('ff').submit();
}

function doSort(col,sekundaer){
    const f=document.getElementById('ff');
    const s1=f.querySelector('[name=sort]');
    const d1=f.querySelector('[name=dir]');
    const s2=f.querySelector('[name=sort2]');
    const d2=f.querySelector('[name=dir2]');
    if(sekundaer){
        if(s2.value===col){ s2.value='';d2.value='asc'; }
        else { s2.value=col; d2.value='asc'; }
    }else{
        const nd=(s1.value===col&&d1.value==='asc')?'desc':'asc';
        s1.value=col;d1.value=nd;
        if(s2.value===col){s2.value='';d2.value='asc';}
    }
    f.submit();
}

async function doAct(type){
    const fileUrl=window.location.origin+dirBase+basePath+selFile;
    const rawUrl=scriptPath+'?path='+encodeURIComponent(<?=json_encode($relPath)?>)+'&raw='+encodeURIComponent(selFile);
    switch(type){
        case 'open': window.location.href=basePath+selFile; break;
        case 'search':
            const sb=document.getElementById('searchBox');
            const vis=sb.style.display==='none';
            sb.style.display=vis?'block':'none';
            if(vis) setTimeout(()=>document.getElementById('searchTerm').focus(),100);
            break;
        case 'shareLink':
            if(navigator.share) navigator.share({title:selFile,url:fileUrl}).catch(e=>{if(e.name!=='AbortError')showErr('Share: '+e.message);});
            else showErr('navigator.share nicht verfügbar');
            break;
        case 'raw': window.location.href=rawUrl; break;
        case 'copy':
            if(navigator.clipboard) navigator.clipboard.writeText(fileUrl).then(()=>{alert('Link kopiert!');closeAll();}).catch(e=>showErr('Clipboard: '+e.message));
            else showErr('Clipboard-API nicht verfügbar');
            break;
        case 'shareText':
            try{
                const r=await fetch(rawUrl,{credentials:'same-origin'});
                if(!r.ok){let m='HTTP '+r.status;if(r.status===403)m+=' · Security-Block?';if(r.status===500)m+=' · open_basedir?';showErr(m);break;}
                const text=await r.text();
                if(!navigator.share){showErr('navigator.share nicht verfügbar');break;}
                try{await navigator.share({title:selFile,text:text});}
                catch(se){if(se.name!=='AbortError')showErr('Share: '+se.name+' · '+se.message);}
            }catch(fe){showErr('Fetch: '+fe.message+(fe.message.includes('Failed')?'· CORS/Security-Block?':''));}
            closeAll(); break;
    }
}

function showErr(m){alert('⚠ '+m);console.error('GRAPPA lsfilter:',m);}

document.addEventListener('DOMContentLoaded',()=>{
    const st=document.getElementById('searchTerm');
    if(!st) return;
    st.addEventListener('keydown', async e=>{
        if(e.key!=='Enter') return;
        e.preventDefault();
        const term=st.value.trim();
        if(!term) return;
        const res=document.getElementById('searchResult');
        res.textContent='Suche…';
        const rawUrl=scriptPath+'?path='+encodeURIComponent(<?=json_encode($relPath)?>)+'&raw='+encodeURIComponent(selFile);
        try{
            const r=await fetch(rawUrl,{credentials:'same-origin'});
            if(!r.ok){res.textContent='Fehler HTTP '+r.status;return;}
            const text=await r.text();
            const lower=text.toLowerCase();
            const tl=term.toLowerCase();
            let count=0,pos=0;const positions=[];
            while((pos=lower.indexOf(tl,pos))!==-1){positions.push(pos);pos+=tl.length;count++;}
            if(count===0){res.style.color='#d32f2f';res.textContent='❌ "'+term+'" nicht gefunden';}
            else{
                res.style.color='#2e7d32';
                let out='✅ '+count+'× gefunden · Erste Treffer:<br>';
                positions.slice(0,5).forEach(p=>{
                    const start=Math.max(0,p-30);
                    const end=Math.min(text.length,p+term.length+30);
                    let snippet=text.slice(start,end).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
                    const tStart=p-start;
                    snippet=snippet.slice(0,tStart)+'<mark>'+snippet.slice(tStart,tStart+term.length)+'</mark>'+snippet.slice(tStart+term.length);
                    out+='…'+snippet+'…<br>';
                });
                res.innerHTML=out;
            }
        }catch(e){res.textContent='Fetch-Fehler: '+e.message;}
    });
});
console.log('GRAPPA lsfilter · <?=$iv['art_nr']?> · <?=$version?> · <?=$iv['framework_version']?> · <?=$si['host']?>');
</script>
