// KLASSE: GrappaUrl (NEU v05.01)
// Single Source of Truth für URL-Zustand · ALLE Schalter mitgeführt
// Scriptbar · wiederholbar · reproduzierbar · kein Mausklick nötig
// ════════════════════════════════════════════════════════════════
class GrappaUrl {
    public static function current(): array {
        return array_filter([
            'format'  => $_GET['format']  ?? null,
            'preset'  => $_GET['preset']  ?? null,
            'pattern' => $_GET['pattern'] ?? null,
            'mode'    => $_GET['mode']    ?? null,
            'since'   => $_GET['since']   ?? null,
            'path'    => $_GET['path']    ?? null,
            'sort'    => $_GET['sort']    ?? null,
            'dir'     => $_GET['dir']     ?? null,
            'sort2'   => $_GET['sort2']   ?? null,
            'dir2'    => $_GET['dir2']    ?? null,
            'q1'      => $_GET['q1']      ?? null,
            'q2'      => $_GET['q2']      ?? null,
            'q3'      => $_GET['q3']      ?? null,
        ], fn($v) => $v !== null && $v !== '');
    }

    public static function build(array $overrides = []): string {
        $params = array_filter(array_merge(self::current(), $overrides), fn($v) => $v !== null && $v !== '');
        return $params ? '?' . http_build_query($params) : '';
    }

    public static function absolute(array $overrides = []): string {
        $proto  = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
        $host   = $_SERVER['HTTP_HOST']   ?? 'localhost';
        $script = $_SERVER['SCRIPT_NAME'] ?? '/lsfilter.php';
        return $proto . '://' . $host . $script . self::build($overrides);
    }
}

