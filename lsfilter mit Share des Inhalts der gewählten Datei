// KLASSE: GrappaOutput (NEU v05.01)
// Format-Router · html | json | csv | txt · offen für alles
// GrappaOutput::register('xml', $fn) — beliebig erweiterbar
// ════════════════════════════════════════════════════════════════
class GrappaOutput {
    private static array $formats = [];
    private static bool  $initialized = false;

    private static function init(): void {
        if (self::$initialized) return;
        self::$initialized = true;
        self::$formats = [
            'json' => [self::class, 'renderJson'],
            'csv'  => [self::class, 'renderCsv'],
            'txt'  => [self::class, 'renderTxt'],
            // html → kein Eintrag → normaler HTML-Flow läuft durch
        ];
    }

    public static function register(string $format, callable $fn): void {
        self::init();
        self::$formats[$format] = $fn;
    }

    public static function requested(): ?string {
        $f = strtolower(trim($_GET['format'] ?? ''));
        return ($f && $f !== 'html') ? $f : null;
    }

    public static function dispatch(array $files, array $meta): bool {
        self::init();
        $format = self::requested();
        if (!$format) return false;
        if (isset(self::$formats[$format])) {
            call_user_func(self::$formats[$format], $files, $meta);
            exit;
        }
        header('Content-Type: application/json; charset=utf-8');
        http_response_code(400);
        echo json_encode([
            'error'             => 'Unbekanntes Format',
            'format_requested'  => $format,
            'formats_available' => array_keys(self::$formats),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
        exit;
    }

    private static function renderJson(array $files, array $meta): void {
        header('Content-Type: application/json; charset=utf-8');
        header('Access-Control-Allow-Origin: *');
        echo json_encode(
            array_merge($meta, ['files' => $files]),
            JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
        );
    }

    private static function renderCsv(array $files, array $meta): void {
        header('Content-Type: text/csv; charset=utf-8');
        header('Content-Disposition: attachment; filename="lsfilter_' . date('Ymd_His') . '.csv"');
        echo "\xEF\xBB\xBF"; // UTF-8 BOM für Excel
        echo "name\tsize\tmodified\tisDir\n";
        foreach ($files as $f) {
            echo implode("\t", [
                $f['name'],
                $f['size'] ?? 0,
                $f['modified'] ?? '',
                isset($f['isDir']) && $f['isDir'] ? '1' : '0',
            ]) . "\n";
        }
    }

    private static function renderTxt(array $files, array $meta): void {
        header('Content-Type: text/plain; charset=utf-8');
        echo '# lsfilter · ' . ($meta['host'] ?? '') . ' · ' . ($meta['generated'] ?? '') . "\n";
        echo '# preset: ' . ($meta['preset'] ?? '-') . ' · count: ' . ($meta['count'] ?? 0) . "\n\n";
        foreach ($files as $f) {
            echo $f['name'] . "\t" . ($f['size'] ?? 0) . "\t" . ($f['modified'] ?? '') . "\n";
        }
    }
}

