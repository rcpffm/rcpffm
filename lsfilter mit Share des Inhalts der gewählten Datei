    }else{http_response_code(403);header('Content-Type: text/plain; charset=utf-8');echo 'GRAPPA: Zugriff verweigert';}
    exit;
}

// ── Scan ─────────────────────────────────────────────────────────
$files=[];$scanErr=null;$regexErr=null;

if(!is_dir($currentPath))         $scanErr='Kein Verzeichnis: '.htmlspecialchars($relPath?:'/');
elseif(!is_readable($currentPath)) $scanErr='Kein Lesezugriff: '.htmlspecialchars($relPath?:'/');
else{
    $items=@scandir($currentPath);
    if($items===false) $scanErr='scandir() fehlgeschlagen';
    else foreach($items as $item){
        if($item==='.'||$item==='..') continue;
        $full=$currentPath.DIRECTORY_SEPARATOR.$item;
        $isDir=is_dir($full);

        // BUG2-FIX: Directories immer anzeigen, unabhängig vom Filter
        if($isDir){
            $files[]=['name'=>$item,'isDir'=>true,'time'=>(int)@filemtime($full),'size'=>0,'crc'=>'','modified'=>''];
            continue;
        }

        // Datei: Filter anwenden
        if($pattern==='.*'||$pattern===''){$match=1;}
        elseif($useRegex){
            $match=@preg_match('#'.$pattern.'#i',$item);
            if($match===false&&$regexErr===null){
                $ec=preg_last_error();
                $en=[PREG_INTERNAL_ERROR=>'INTERNAL',PREG_BACKTRACK_LIMIT_ERROR=>'BACKTRACK_LIMIT',
                     PREG_RECURSION_LIMIT_ERROR=>'RECURSION_LIMIT',PREG_BAD_UTF8_ERROR=>'BAD_UTF8',PREG_JIT_STACKLIMIT_ERROR=>'JIT_STACKLIMIT'];
                $regexErr='Regex-Fehler: '.($en[$ec]??'Code '.$ec).' · Pattern: '.htmlspecialchars($pattern);
                $match=0;
            }
        }else{$match=stripos($item,$pattern)!==false?1:0;}

        if($match){
            $mtime=(int)@filemtime($full);
            $sz=(int)@filesize($full);
            $files[]=['name'=>$item,'isDir'=>false,'time'=>$mtime,'size'=>$sz,'crc'=>'',
                      'modified'=>date('c',$mtime)]; // v05.01: modified für GrappaOutput
        }
    }

    // ── Sortierung ───────────────────────────────────────────────
    usort($files,function($a,$b)use($sortCol,$sortDir,$sortCol2,$sortDir2){
        if($a['isDir']!==$b['isDir']) return $b['isDir']-$a['isDir'];
        $cmp=function($x,$y,$col){
            return match($col){
                'size' =>$x['size']<=>$y['size'],
                'time' =>$x['time']<=>$y['time'],
                default=>strcasecmp($x['name'],$y['name']),
            };
        };
        $r=$cmp($a,$b,$sortCol);
        if($r===0&&$sortCol2) $r=$cmp($a,$b,$sortCol2)*($sortDir2==='desc'?-1:1);
        return $sortDir==='desc'?-$r:$r;
    });

    // ── Duplikat-Erkennung nach Größe (Bytes exakt) ──────────────
    $sizeMap=[];
    foreach($files as $i=>$f){
        if(!$f['isDir']&&$f['size']>0) $sizeMap[$f['size']][]=$i;
    }
    $dupSizes=[];$crcGroups=[];
    foreach($sizeMap as $sz=>$idxs){
        if(count($idxs)<2) continue;
        $dupSizes[$sz]=true;
        $crcs=[];
        foreach($idxs as $i){
            $fp=$currentPath.DIRECTORY_SEPARATOR.$files[$i]['name'];
            if(is_readable($fp)&&$sz<5242880){
                $crcs[$i]=hash_file('crc32b',$fp);
                $files[$i]['crc']=$crcs[$i];
            }
        }
        $crcBuckets=[];
        foreach($crcs as $i=>$c) $crcBuckets[$c][]=$i;
        foreach($crcBuckets as $c=>$cidxs)
            if(count($cidxs)>1) foreach($cidxs as $i) $crcGroups[$i]=$c;
    }
}

