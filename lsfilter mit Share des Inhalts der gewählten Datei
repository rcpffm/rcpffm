// KLASSE: GrappaNav (NEU v05.01)
// Navigation · eine Ebene höher · root-Schutz · Breadcrumbs
// ════════════════════════════════════════════════════════════════
class GrappaNav {
    private string $root;
    private string $relPath;

    public function __construct(string $root, string $relPath) {
        $this->root    = rtrim($root, DIRECTORY_SEPARATOR);
        $this->relPath = trim($relPath, '/');
    }

    public function isRoot(): bool {
        return $this->relPath === '';
    }

    public function parentPath(): string {
        if ($this->isRoot()) return '';
        $parts = explode('/', $this->relPath);
        array_pop($parts);
        return implode('/', $parts);
    }

    public function parentUrl(array $extraParams = []): string {
        if ($this->isRoot()) return '';
        $params = array_merge($extraParams, ['path' => $this->parentPath()]);
        return '?' . http_build_query(array_filter($params, fn($v) => $v !== null && $v !== ''));
    }

    public function renderUpLink(string $label = '.. ↑ eine Ebene höher'): string {
        if ($this->isRoot()) return '';
        $url = htmlspecialchars($this->parentUrl());
        return '<a class="nav-up-link" href="' . $url . '">' . htmlspecialchars($label) . '</a> ';
    }

    public function breadcrumbs(): array {
        $crumbs = [['label' => '/', 'url' => '?path=', 'isRoot' => true]];
        if ($this->isRoot()) return $crumbs;
        $parts = explode('/', $this->relPath);
        $built = '';
        foreach ($parts as $part) {
            $built = $built ? $built . '/' . $part : $part;
            $crumbs[] = ['label' => $part, 'url' => '?path=' . urlencode($built), 'isRoot' => false];
        }
        return $crumbs;
    }

    public function currentAbsPath(): string {
        if ($this->isRoot()) return $this->root;
        return $this->root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $this->relPath);
    }
}

