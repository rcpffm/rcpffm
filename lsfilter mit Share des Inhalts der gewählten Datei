}

// Query-String Helfer für Sortier-Links
function sortUrl(string $col):string{
    global $relPath,$pattern,$mode,$sortCol,$sortDir,$sortCol2,$sortDir2;
    $newDir=($sortCol===$col&&$sortDir==='asc')?'desc':'asc';
    return '?path='.urlencode($relPath).'&pattern='.urlencode($pattern)
          .'&mode='.urlencode($mode).'&sort='.urlencode($col).'&dir='.urlencode($newDir)
          .($sortCol2?'&sort2='.urlencode($sortCol2).'&dir2='.urlencode($sortDir2):'');
}
function sortArrow(string $col):string{
    global $sortCol,$sortDir,$sortCol2,$sortDir2;
    if($sortCol===$col){
        $arr=$sortDir==='asc'?'▲▲':'▼▼';
        return '<strong style="color:#e8320a;letter-spacing:-3px">'.$arr.'</strong>';
    }
    if($sortCol2===$col){
        $arr=$sortDir2==='asc'?'▲':'▼';
        return '<span style="color:#aaa">'.$arr.'</span>';
    }
    return '<span style="color:#ddd">⇅</span>';
}

