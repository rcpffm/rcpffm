// KLASSE: GrappaPreset (NEU v05.01)
// Erweiterbare Preset-Registry · getrennt von GrappaFilter
// GrappaPreset::register('key', '/regex/') — jederzeit erweiterbar
// ════════════════════════════════════════════════════════════════
class GrappaPreset {
    private static array $presets = [];
    private static bool  $initialized = false;

    private static function init(): void {
        if (self::$initialized) return;
        self::$initialized = true;
        self::$presets = [
            'art_json'  => ltrim(rtrim(ART_JSON_RE, '/'), '/'),
            'art_all'   => '^ART-\d{4}-\d{4}-\d{6}\.\d{4}',
            'art_txt'   => '^ART-\d{4}-\d{4}-\d{6}\.\d{4}.*\.jsontxt$',
            'erl'       => '^ERL\d*_',
            'grappa'    => '^Grappa\d{5}\.',
            'html'      => '\.(html?|php|js|css)$',
            'json'      => '\.(json|jsontxt)$',
            'md'        => '\.md$',
            'all'       => '.*',
        ];
    }

    public static function register(string $key, string $regex): void {
        self::init();
        self::$presets[$key] = $regex;
    }

    public static function get(string $key): ?string {
        self::init();
        return self::$presets[$key] ?? null;
    }

    public static function all(): array {
        self::init();
        return self::$presets;
    }

    // Aus ?preset= URL-Parameter auflösen
    public static function fromRequest(): ?string {
        self::init();
        $preset = $_GET['preset'] ?? '';
        if ($preset !== '' && isset(self::$presets[$preset])) {
            return self::$presets[$preset];
        }
        return null;
    }
}

