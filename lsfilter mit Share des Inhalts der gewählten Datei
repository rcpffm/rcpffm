// ── RAW-Proxy ────────────────────────────────────────────────────
if(isset($_GET['raw'])){
    $f=realpath($currentPath.DIRECTORY_SEPARATOR.$_GET['raw']);
    if($f&&str_starts_with($f,$basePath)&&is_file($f)){
        $sz=filesize($f);
        header('Content-Type: text/plain; charset=utf-8');
        header('X-GRAPPA-Filesize: '.$sz);
        if($sz>102400)header('X-GRAPPA-Warning: file-large-'.$sz);
