/**
 * importantValues()
 * v02.07 - Fix: Robust File Ops, Silent Handshake & JSON-Encoding for JS
 */
function importantValues() {
    return [
        'version' => 'v02.07',
        'author'  => 'rcpffm & misc. AIs',
        'created' => '2026-04-12 09:40:00 UTC',
        '_doc'    => '
### [DE] Logik-Korrekturen v02.07
1. **Stabilität**: Dateizugriffe (JSON/BAK) sind nun fehlerunterdrückt (@), um Abstürze bei fehlenden Schreibrechten zu verhindern.
2. **Datentransfer**: PHP-Variablen werden via `json_encode` an JS übergeben (verhindert Syntax-Fehler in JS).
3. **Regex-Sicherheit**: Nutzt `#` als Delimiter, um Pfad-Slashes `/` ohne Konflikte zu verarbeiten.

### [EN] Logic Fixes v02.07
1. **Stability**: File operations (JSON/BAK) are now error-suppressed (@) to prevent crashes on restricted filesystems.
2. **Data Transfer**: PHP variables passed to JS via `json_encode` (prevents JS syntax errors).
3. **Regex Safety**: Uses `#` as delimiter to handle path slashes `/` without conflicts.
'
    ];
}

$meta = importantValues();
$version = $meta['version'];

// --- DEFAULTS ---
$defPath    = '';
$defPattern = '.*';
$defSort    = 'time';
$defDir     = 'desc';
$defRegex   = 'y';

// --- STABILER HANDSHAKE ---
// Wir prüfen, ob mind. ein erwarteter Parameter fehlt
if (!isset($_GET['path']) && !isset($_GET['sort'])) {
    $jsonDefaults = json_encode([
        'path'    => $defPath,
        'pattern' => $defPattern,
        'sort'    => $defSort,
        'dir'     => $defDir,
        'regex'   => $defRegex
    ]);
    echo "<script>
        try {
            const stored = JSON.parse(localStorage.getItem('lsfilter_params') || '$jsonDefaults');
            const p = new URLSearchParams();
            Object.keys(stored).forEach(k => p.set(k, stored[k]));
            window.location.search = p.toString();
        } catch(e) { window.location.search = '?path=&sort=time&dir=desc&regex=y&pattern=.*'; }
    </script>";
    exit;
}

// --- PARAMETER-CLEANUP ---
$relPath  = str_replace(['..', '\\'], '', $_GET['path'] ?? $defPath);
$relPath  = trim($relPath, '/');
$pattern  = $_GET['pattern'] ?? $defPattern;
$sort     = $_GET['sort']    ?? $defSort;
$dir      = $_GET['dir']     ?? $defDir;
$useRegex = in_array(strtolower($_GET['regex'] ?? $defRegex), ['1', 'y', 'j'], true);

$basePath = realpath('.'); 
$currentScanPath = ($relPath === '') ? $basePath : $basePath . DIRECTORY_SEPARATOR . $relPath;

// --- SCAN & FILTER ---
$fileInfo = [];
if (is_dir($currentScanPath)) {
    $items = @scandir($currentScanPath);
    if ($items) {
        foreach ($items as $item) {
            if ($item === '.' || $item === '..') continue;
            $fullPath = $currentScanPath . DIRECTORY_SEPARATOR . $item;
            $isDir    = is_dir($fullPath);
            
            // Regex-Check mit '#' statt '/' als Delimiter (robuster für Pfade)
            $match = true;
            if ($pattern !== '') {
                if ($useRegex) {
                    $match = @preg_match('#' . $pattern . '#i', $item);
                } else {
                    $match = (stripos($item, $pattern) !== false);
                }
            }

            if ($match) {
                $fileInfo[] = [
                    'name'  => $item,
                    'web'   => ($relPath === '') ? $item : $relPath . '/' . $item,
                    'time'  => @filemtime($fullPath) ?: 0,
                    'size'  => $isDir ? 0 : (@filesize($fullPath) ?: 0),
                    'isDir' => $isDir,
                    'ext'   => strtolower(pathinfo($item, PATHINFO_EXTENSION))
                ];
            }
        }
    }
}

// --- SORTIERUNG ---
usort($fileInfo, function ($a, $b) use ($sort, $dir) {
    if ($sort === 'size') $cmp = $a['size'] <=> $b['size'];
    elseif ($sort === 'time') $cmp = $a['time'] <=> $b['time'];
    else $cmp = strcasecmp($a['name'], $b['name']);
    return ($dir === 'asc') ? $cmp : -$cmp;
});

// --- JSON EXPORT (Silent & Robust) ---
$jsonPath = $basePath . DIRECTORY_SEPARATOR . 'lsResult.json';
$bakPath  = $basePath . DIRECTORY_SEPARATOR . 'latest_lsResult.bak';

$exportData = [
    'meta'    => $meta,
    'context' => [
        'script_root' => $basePath,
        'scan_time'   => date('Y-m-d H:i:s').' UTC',
        'host'        => $_SERVER['HTTP_HOST'] ?? 'localhost'
    ],
    'params'  => ['path' => $relPath, 'pattern' => $pattern, 'sort' => $sort, 'dir' => $dir, 'regex' => $useRegex ? 'y' : 'n'],
    'results' => $fileInfo
];

// Fehlerunterdrückung bei Schreibvorgängen
if (is_writable($basePath)) {
    if (file_exists($jsonPath)) { @rename($jsonPath, $bakPath); }
    @file_put_contents($jsonPath, json_encode($exportData, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
}

function headerLink($label, $col, $sort, $dir, $pattern, $regex, $path) {
    $newDir = ($sort === $col) ? (($dir === 'asc') ? 'desc' : 'asc') : 'asc';
    $params = ['path' => $path, 'sort' => $col, 'dir' => $newDir, 'pattern' => $pattern, 'regex' => $regex ? 'y' : 'n'];
    $arrow = ($sort === $col) ? (($dir === 'asc') ? ' ▲' : ' ▼') : '';
    return '<a href="?' . http_build_query($params) . '" style="text-decoration:none; color:inherit;">' . htmlspecialchars($label) . '<small>' . $arrow . '</small></a>';
}
?>
