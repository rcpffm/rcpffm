        <th class="size-col"><?= headerLink('Größe', 'size', $sort, $dir, $pattern, $useRegex, $relPath) ?></th>
    </tr>
</thead>
<tbody>
<?php if (empty($fileInfo)): ?>
    <tr><td colspan="3" style="text-align:center; padding:20px; color:gray;">Keine Dateien gefunden oder Zugriff verweigert.</td></tr>
<?php endif; ?>
<?php foreach ($fileInfo as $f): ?>
    <tr class="<?= $f['isDir'] ? 'is-dir' : '' ?>">
        <td>
            <a href="<?= $f['isDir'] ? '?path='.urlencode($f['web']).'&sort='.$sort.'&dir='.$dir.'&pattern='.urlencode($pattern).'&regex='.($useRegex?'y':'n') : htmlspecialchars($f['web']) ?>" <?= $f['isDir'] ? '' : 'target="_blank"' ?>>
                <?= $f['isDir'] ? '📁' : '📄' ?> <?= htmlspecialchars($f['name']) ?>
            </a>
        </td>
        <td style="font-size:0.85em;"><?= $f['time'] > 0 ? date('d.m.y H:i', $f['time']) : '--' ?></td>
        <td class="size-col"><?= $f['isDir'] ? 'DIR' : number_format($f['size']/1024, 1).'K' ?></td>
    </tr>
<?php endforeach; ?>
</tbody>
</table>

<script>
// PHP-Daten sicher an JS übergeben
const currentParams = <?= json_encode([
    'path'    => $relPath,
    'pattern' => $pattern,
    'sort'    => $sort,
    'dir'     => $dir,
    'regex'   => $useRegex ? 'y' : 'n'
]) ?>;
localStorage.setItem('lsfilter_params', JSON.stringify(currentParams));
</script>

</body>
