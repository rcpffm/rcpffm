        <input type="text" name="pattern" value="<?= htmlspecialchars($pattern) ?>" placeholder="Filter..." style="width:150px;">
        <select name="regex">
            <option value="y" <?= $useRegex?'selected':'' ?>>Regex</option>
            <option value="n" <?= !$useRegex?'selected':'' ?>>Text</option>
